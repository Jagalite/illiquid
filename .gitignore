# Rebuilt locally by the Native Apple vs IINA benchmark scripts. Keep hashes,
# probes, commands, raw measurements, and reports in Git; exclude multi-gigabyte
# generated media and app bundles.
Benchmarks/NativeAppleVsIINA/apps/
Benchmarks/NativeAppleVsIINA/fixtures/*.mov
Benchmarks/NativeAppleVsIINA/fixtures/*.mkv

# Extracted sidecar research receipts are packaged in the committed archive.
Benchmarks/SidecarAncestorHints/evidence/**/*.jsonl
Benchmarks/SidecarAncestorHints/evidence/**/*.log
Benchmarks/SidecarAncestorHints/evidence/**/*-outputs.json.gz
!Benchmarks/SidecarAncestorHints/evidence/verification-outputs.json.gz
