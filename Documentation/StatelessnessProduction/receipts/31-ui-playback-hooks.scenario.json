{
 "schema_version": 1,
 "name": "playback-hooks",
 "description": "Hook-driven variant of playback-shortcuts for hosts where synthetic key posting fails: play, pause and exact seeks go through the benchmark control hook into the real controller and playback session. Main-actor state assertions, not visible frame or audio-output proof.",
 "requires": [],
 "steps": [
  {
   "id": "discover-state-hook",
   "command": "hook",
   "args": {
    "action": "capabilities"
   },
   "expect": {
    "path": "data.state.data.commands",
    "op": "contains",
    "value": "agent-state"
   }
  },
  {
   "id": "fixture-duration",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.duration_seconds",
     "op": "gte",
     "value": 10
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "fixture-loaded",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.loading",
     "op": "eq",
     "value": false
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "player-focused",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.window.key",
     "op": "eq",
     "value": true
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "setup-paused",
   "command": "hook",
   "args": {
    "action": "pause"
   }
  },
  {
   "id": "confirm-paused-setup",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.pause_desired",
     "op": "eq",
     "value": true
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "hook-seek-start",
   "command": "hook",
   "args": {
    "action": "seek-exact",
    "targetSeconds": 1
   }
  },
  {
   "id": "seek-start-observed",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.position_seconds",
     "op": "lte",
     "value": 1.5
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "hook-play",
   "command": "hook",
   "args": {
    "action": "play"
   }
  },
  {
   "id": "play-request-observed",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.pause_desired",
     "op": "eq",
     "value": false
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "playback-advances",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.position_seconds",
     "op": "gte",
     "value": 3.0
    },
    "timeout": 15,
    "interval": 0.1
   }
  },
  {
   "id": "hook-pause",
   "command": "hook",
   "args": {
    "action": "pause"
   }
  },
  {
   "id": "pause-request-observed",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.pause_desired",
     "op": "eq",
     "value": true
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "setup-seek-origin",
   "command": "hook",
   "args": {
    "action": "seek-exact",
    "targetSeconds": 2
   }
  },
  {
   "id": "seek-origin-lower-bound",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.position_seconds",
     "op": "gte",
     "value": 1.8
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "seek-origin-upper-bound",
   "command": "assert",
   "args": {
    "path": "data.state.data.playback.position_seconds",
    "op": "lte",
    "value": 2.2
   }
  },
  {
   "id": "hook-seek-forward",
   "command": "hook",
   "args": {
    "action": "seek-exact",
    "targetSeconds": 7
   }
  },
  {
   "id": "forward-seek-lower-bound",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.position_seconds",
     "op": "gte",
     "value": 6.5
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "forward-seek-upper-bound",
   "command": "assert",
   "args": {
    "path": "data.state.data.playback.position_seconds",
    "op": "lte",
    "value": 7.5
   }
  },
  {
   "id": "hook-seek-backward",
   "command": "hook",
   "args": {
    "action": "seek-exact",
    "targetSeconds": 2
   }
  },
  {
   "id": "backward-seek-upper-bound",
   "command": "wait",
   "args": {
    "command": "hook",
    "args": {
     "action": "agent-state"
    },
    "condition": {
     "path": "data.state.data.playback.position_seconds",
     "op": "lte",
     "value": 2.5
    },
    "timeout": 10,
    "interval": 0.1
   }
  },
  {
   "id": "backward-seek-lower-bound",
   "command": "assert",
   "args": {
    "path": "data.state.data.playback.position_seconds",
    "op": "gte",
    "value": 1.5
   }
  }
 ],
 "metrics": {
  "required": []
 }
}