  "baseline_adapter": "import Foundation\n\nenum SourceFilesystemEventBatch {\n    static func decode(paths: UnsafeBufferPointer<UnsafePointer<CChar>?>,\n        flagsAt: (Int) -> SourceFilesystemEvent.Flags) -> [SourceFilesystemEvent] {\n        let count = paths.count\n        guard let pointers = paths.baseAddress else { return [] }\n        var events: [SourceFilesystemEvent] = []\n        events.reserveCapacity(count)\n        for index in 0..<count {\n            guard let pointer = pointers[index] else { continue }\n            events.append(.init(path: String(cString: pointer), flags: flagsAt(index)))\n        }\n        return events\n    }\n}\n",
