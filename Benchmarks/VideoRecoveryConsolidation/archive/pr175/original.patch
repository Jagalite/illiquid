+            --output "$RUNNER_TEMP/recovery-lifetime"
+      - name: Emit reproducible ownership evidence
+        if: always()
+        run: |
+          python3 - <<'PY'
+          import base64, gzip, hashlib, json, os
+          from pathlib import Path
+          root = Path(os.environ['RUNNER_TEMP']) / 'recovery-lifetime'
+          files = {}
+          for path in sorted(root.rglob('*')):
+              relative = path.relative_to(root)
+              if path.is_file() and 'build' not in relative.parts:
+                  files[str(relative)] = path.read_text()
+          packed = gzip.compress(json.dumps(files, sort_keys=True).encode(), compresslevel=9, mtime=0)
+          print('RECOVERY_GOP_EVIDENCE_SHA256 ' + hashlib.sha256(packed).hexdigest())
+          if len(packed) > 2 * 1024 * 1024:
+              raise SystemExit('Evidence exceeds inline limit; use the artifact')
+          print('RECOVERY_GOP_EVIDENCE_BASE64 ' + base64.b64encode(packed).decode())
+          if 'summary.json' in files:
+              print(files['summary.json'])
