diff --git a/Sources/IlliquidNativePlayback/Media/FFmpegPacketReadStep.swift b/Sources/IlliquidNativePlayback/Media/FFmpegPacketReadStep.swift
new file mode 100644
--- /dev/null
+++ b/Sources/IlliquidNativePlayback/Media/FFmpegPacketReadStep.swift
@@ -0,0 +1,60 @@
+import CFFmpeg
+import Foundation
+
+/// A value-only pacing observation. It never retains the AVPacket, side data,
+/// or payload. Optional times retain FFmpeg's missing-timestamp semantics.
+struct FFmpegPacketProgress: Equatable, Sendable {
+    let streamIndex: Int32
+    let presentationTimestamp: Int64
+    let decodeTimestamp: Int64
+    let timeBase: FFmpegRational
+    let generation: Int
+
+    init(packet: UnsafePointer<AVPacket>, timeBase: AVRational, generation: Int) {
+        streamIndex = packet.pointee.stream_index
+        presentationTimestamp = packet.pointee.pts
+        decodeTimestamp = packet.pointee.dts
+        self.timeBase = FFmpegRational(timeBase)
+        self.generation = generation
+    }
+
+    var presentationSeconds: Double? {
+        presentationTimestamp == illiquid_nopts_value()
+            ? nil : MediaTime.seconds(presentationTimestamp, timeBase: timeBase)
+    }
+
+    var decodeSeconds: Double? {
+        decodeTimestamp == illiquid_nopts_value()
+            ? nil : MediaTime.seconds(decodeTimestamp, timeBase: timeBase)
+    }
+}
+
+/// Progress is not EOF: only a nil read result denotes end of input. Errors
+/// and cancellation are still thrown by the existing bounded read policy.
+enum FFmpegPacketReadStep: Sendable {
+    case packet(FFmpegPacket)
+    case progress(FFmpegPacketProgress)
+
+    var generation: Int {
+        switch self {
+        case .packet(let packet): packet.generation
+        case .progress(let progress): progress.generation
+        }
+    }
+    var decodeSeconds: Double? {
+        switch self {
+        case .packet(let packet): packet.decodeSeconds
+        case .progress(let progress): progress.decodeSeconds
+        }
+    }
+    var presentationSeconds: Double? {
+        switch self {
+        case .packet(let packet): packet.presentationSeconds
+        case .progress(let progress): progress.presentationSeconds
+        }
+    }
+    var packet: FFmpegPacket? {
+        guard case .packet(let packet) = self else { return nil }
+        return packet
+    }
+}
