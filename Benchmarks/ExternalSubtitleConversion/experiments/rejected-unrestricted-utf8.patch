+    private static func escapedText(_ lines: ArraySlice<Substring>) -> String {
+        var bytes: [UInt8] = []
+        bytes.reserveCapacity(lines.reduce(0) { $0 + $1.utf8.count }
+            + max(0, lines.count - 1) * 2)
+        var needsLineBreak = false
+        for line in lines {
+            if needsLineBreak { bytes.append(contentsOf: [0x5C, 0x4E]) } // \N
+            needsLineBreak = true
+            // These ASCII bytes cannot occur inside a multibyte UTF-8 scalar.
+            // Work in UTF-8 so a combining mark attached to a delimiter does
+            // not hide it inside a larger Swift Character.
+            for byte in line.utf8 {
+                if byte == 0x5C || byte == 0x7B || byte == 0x7D {
+                    bytes.append(0x5C)
+                }
+                bytes.append(byte)
+            }
+        }
+        return String(decoding: bytes, as: UTF8.self)
